# Copy to .env and fill in. .env is git-ignored and read by the backend
# through spring.config.import (KEY=value, no quotes, no `export`).
# Every variable is documented in docs/deployment.md §4.
# Variables marked (later) are not used yet; they arrive with the module that needs them.

# --- Database (local defaults match docker-compose.yml) ---
DB_URL=jdbc:postgresql://localhost:5433/hireflow
DB_USERNAME=hireflow
DB_PASSWORD=hireflow

# --- Web ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# --- Auth ---
# Locally, leave JWT_SECRET commented out to use the built-in dev placeholder
# (an empty "JWT_SECRET=" counts as set and fails startup). REQUIRED in production:
#   openssl rand -base64 32
# JWT_SECRET=
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D
# Browsers treat http://localhost as secure, so true works in local development too.
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax
# Creates the first super admin at startup if none exists. Password: 8+ chars, a letter and a digit.
SUPER_ADMIN_NAME=Platform Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- AI: Google Gemini API (later: Day 11) ---
# Free-tier key from Google AI Studio: use made-up resumes only.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_DAILY_QUOTA_PER_COMPANY=200

# --- File storage: local disk in development, Cloudinary in production (wired up on Day 6) ---
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./data/uploads
# Required when STORAGE_TYPE=cloudinary: cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_URL=
CLOUDINARY_FOLDER=hireflow-dev
# Local storage only: where the API serves public images
STORAGE_LOCAL_PUBLIC_URL=http://localhost:8080/media

# --- Demo data (later) ---
DEMO_PASSWORD=

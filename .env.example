# Copy to .env and fill in. .env is git-ignored and read by the backend
# through spring.config.import (KEY=value, no quotes, no `export`).
# Every variable is documented in docs/deployment.md §4.
# Variables marked (later) are not used yet; they arrive with the module that needs them.

# --- Database (local defaults match docker-compose.yml) ---
DB_URL=jdbc:postgresql://localhost:5433/hireflow
DB_USERNAME=hireflow
DB_PASSWORD=hireflow

# --- Web ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# --- Auth (later: Day 3) ---
# Generate with: openssl rand -base64 32
JWT_SECRET=
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D
COOKIE_SECURE=false
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- AI: Google Gemini API (later: Day 11) ---
# Free-tier key from Google AI Studio: use made-up resumes only.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_DAILY_QUOTA_PER_COMPANY=200

# --- File storage (later: Day 6) ---
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./data/uploads
STORAGE_S3_BUCKET=
AWS_REGION=

# --- Demo data (later) ---
DEMO_PASSWORD=
